{
  "name": "@malinamnam/pi-phone",
  "version": "0.0.14",
  "description": "Phone-first remote UI extension for Pi with Tailscale-friendly access",
  "type": "module",
  "homepage": "https://github.com/jvz-devx/pi-phone#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jvz-devx/pi-phone.git"
  },
  "bugs": {
    "url": "https://github.com/jvz-devx/pi-phone/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "extension",
    "phone",
    "mobile",
    "tailscale"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.ts",
    "phone-session-pool.ts",
    "src",
    "public",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "bundledDependencies": [
    "ws"
  ],
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": ">=0.58.4 <1.0.0"
  },
  "peerDependenciesMeta": {
    "@mariozechner/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mariozechner/pi-ai": "^0.73.0",
    "@mariozechner/pi-coding-agent": "^0.73.0",
    "@types/node": "^24.3.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.7.3"
  }
}
