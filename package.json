{
  "name": "@malinamnam/pi-phone",
  "version": "0.0.14",
  "description": "Phone-first remote UI extension for Pi with Tailscale-friendly access",
  "type": "module",
  "homepage": "https://github.com/jvz-devx/pi-phone#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jvz-devx/pi-phone.git"
  },
  "bugs": {
    "url": "https://github.com/jvz-devx/pi-phone/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "extension",
    "phone",
    "mobile",
    "tailscale"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.ts",
    "phone-session-pool.ts",
    "src",
    "public",
    "frontend",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "static:fallback:check": "node scripts/check-phone-static-fallback.mjs",
    "svelte:validation:check": "node scripts/check-svelte-validation-coverage.mjs",
    "test": "npm run typecheck && npm run static:fallback:check && npm run svelte:validation:check && npm run frontend:test:fixtures",
    "frontend:install": "npm install --prefix frontend",
    "frontend:test:fixtures": "npm run test:fixtures --prefix frontend",
    "frontend:dev": "npm run dev --prefix frontend",
    "frontend:check": "npm run check --prefix frontend",
    "frontend:build": "npm run build --prefix frontend",
    "frontend:preview": "npm run preview --prefix frontend",
    "frontend:sync-public:dry-run": "node scripts/release-sveltekit-public.mjs --dry-run",
    "frontend:sync-public": "node scripts/release-sveltekit-public.mjs --confirm",
    "frontend:shadcn:add": "npm run shadcn:add --prefix frontend --"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.18.3"
  },
  "bundledDependencies": [
    "qrcode",
    "ws"
  ],
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": ">=0.58.4 <1.0.0"
  },
  "peerDependenciesMeta": {
    "@mariozechner/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mariozechner/pi-ai": "^0.73.0",
    "@mariozechner/pi-coding-agent": "^0.73.0",
    "@types/node": "^24.3.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "typescript": "^5.7.3"
  }
}
